{% extends '@BackOfficeDefaultTwig/base.html.twig' %}
{% set d = 'rewriteurl.bo.default' %}

{% block title %}{{ 'List of Gone (410) URLs'|trans({}, d) }}{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-1">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans({}, d) }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Manage Gone (410) URLs'|trans({}, d) }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h1 class="h4 mb-0">{{ 'Manage Gone (410) URLs'|trans({}, d) }}</h1>
            <div class="d-flex gap-2">
                <form action="{{ path('admin_rewrite_url_manage_gone_url_search') }}" method="get">
                    <input type="hidden" name="success_url" value="{{ path('admin_rewrite_url_manage_gone_url_show') }}">
                    <div class="input-group">
                        <input type="text" name="search_term" class="form-control" placeholder="{{ 'Search in URL'|trans({}, d) }}" value="{{ search }}">
                        <button class="btn btn-secondary" type="submit"><i class="bi bi-search"></i></button>
                        {% if search %}
                            <a href="{{ path('admin_rewrite_url_manage_gone_url_show') }}" class="btn btn-secondary" title="{{ 'Reset search'|trans({}, d) }}"><i class="bi bi-x-lg"></i></a>
                        {% endif %}
                    </div>
                </form>
                <form action="{{ path('admin_rewrite_url_manage_gone_url_clear') }}" method="post" class="js-clear-gone-urls">
                    <button type="submit" class="btn btn-danger">{{ 'Clear all gone URLs'|trans({}, d) }}</button>
                </form>
            </div>
        </div>
        <div class="card-body">
            {% set table_rows = [] %}
            {% for goneUrl in goneUrls %}
                {% set action_html %}
                    <button type="button" class="btn btn-danger btn-sm js-delete-gone-url"
                            data-id="{{ goneUrl.ID }}"
                            title="{{ 'Delete'|trans({}, d) }}">{{ 'Delete'|trans({}, d) }}</button>
                {% endset %}
                {% set table_rows = table_rows|merge([{
                    'url_source': '<a href="/' ~ goneUrl.URL_SOURCE|e ~ '" target="_blank">' ~ goneUrl.URL_SOURCE|e ~ '</a>',
                    'created_at': goneUrl.CREATED_AT ? goneUrl.CREATED_AT|date('d/m/y') : '',
                    'updated_at': goneUrl.UPDATED_AT ? goneUrl.UPDATED_AT|date('d/m/y') : '',
                    '_action':    action_html,
                }]) %}
            {% endfor %}

            {{ component('BoDataTable', {
                id: 'gone-urls',
                columns: [
                    column_html('url_source', 'URL Source'|trans({}, d)),
                    column_text('created_at', 'Created At'|trans({}, d), 'center'),
                    column_text('updated_at', 'Updated At'|trans({}, d), 'center'),
                    column_html('_action',    'Actions'|trans({}, d),    'end'),
                ],
                rows: table_rows,
                emptyMessage: search ? 'No results found for your search.'|trans({}, d) : 'No gone URL found.'|trans({}, d),
            }) }}

            {% if pageCount > 1 %}
                <nav class="mt-3"><ul class="pagination pagination-sm">
                    {% for p in 1..pageCount %}
                        <li class="page-item{% if p == page %} active{% endif %}">
                            <a class="page-link" href="?page={{ p }}{% if search %}&search={{ search }}{% endif %}">{{ p }}</a>
                        </li>
                    {% endfor %}
                </ul></nav>
            {% endif %}
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const deleteBaseAction = "{{ path('admin_rewrite_url_manage_gone_url_delete', {'id': '__ID__'}) }}";

        document.querySelectorAll('.js-delete-gone-url').forEach(function (button) {
            button.addEventListener('click', async function () {
                if (!confirm("{{ 'Are you sure you want to delete this URL?'|trans({}, d) }}")) {
                    return;
                }

                const id = this.dataset.id;

                try {
                    const response = await fetch(deleteBaseAction.replace('__ID__', id), {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type': 'application/json',
                        },
                    });

                    if (!response.ok) {
                        throw new Error('Network error');
                    }

                    const data = await response.json();

                    if (data.success) {
                        this.closest('tr').remove();
                    } else {
                        alert("{{ 'Delete failed.'|trans({}, d) }}");
                    }
                } catch (e) {
                    console.error(e);
                }
            });
        });

        document.querySelectorAll('.js-clear-gone-urls').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!confirm("{{ 'Are you sure you want to clear all gone URLs? This action is irreversible.'|trans({}, d) }}")) {
                    event.preventDefault();
                }
            });
        });
    });
</script>
{% endblock %}
