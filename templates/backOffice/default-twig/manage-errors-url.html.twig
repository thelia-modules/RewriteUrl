{% extends '@BackOfficeDefaultTwig/base.html.twig' %}
{% set d = 'rewriteurl.bo.default' %}

{% block title %}{{ 'List of 404 Error URLs'|trans({}, d) }}{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-1">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans({}, d) }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Manage 404 Error URLs'|trans({}, d) }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h1 class="h4 mb-0">{{ 'Manage 404 Error URLs'|trans({}, d) }}</h1>
            <div class="d-flex gap-2">
                <form action="{{ path('admin_rewrite_url_manage_error_url_search_url') }}" method="get">
                    <input type="hidden" name="success_url" value="{{ path('admin_rewrite_url_manage_error_url_show') }}">
                    <div class="input-group">
                        <input type="text" name="search_term" class="form-control" placeholder="{{ 'Search in url or user agent'|trans({}, d) }}" value="{{ search }}">
                        <button class="btn btn-secondary" type="submit"><i class="bi bi-search"></i></button>
                    </div>
                </form>
                <a href="{{ path('admin_rewrite_url_manage_error_url_delete_all') }}" class="btn btn-danger js-delete-all">{{ 'Delete All Errors Urls'|trans({}, d) }}</a>
            </div>
        </div>
        <div class="card-body">
            {% set table_rows = [] %}
            {% for error in errorUrls %}
                {% set action_html %}
                    <button type="button" class="btn btn-primary btn-sm redirection-button"
                            data-bs-toggle="modal" data-bs-target="#edit_error_redirection_dialog"
                            data-id="{{ error.ID }}" data-redirect="{{ error.REDIRECT }}"
                            title="{{ 'Redirection'|trans({}, d) }}">{{ 'Redirection'|trans({}, d) }}</button>
                    <button type="button" class="btn btn-info btn-sm referer-list-button"
                            data-bs-toggle="modal" data-bs-target="#referer_list_dialog"
                            data-id="{{ error.ID }}"
                            title="{{ 'Sources'|trans({}, d) }}">{{ 'Sources'|trans({}, d) }}</button>
                {% endset %}
                {% set table_rows = table_rows|merge([{
                    'url_source': '<a href="/' ~ error.URL_SOURCE|e ~ '" target="_blank">' ~ error.URL_SOURCE|e ~ '</a>',
                    'user_agent': error.USER_AGENT,
                    'count':      error.COUNT,
                    'updated_at': error.UPDATED_AT ? error.UPDATED_AT|date('d/m/y') : '',
                    '_action':    action_html,
                }]) %}
            {% endfor %}

            {{ component('BoDataTable', {
                id: 'error-urls',
                columns: [
                    column_html('url_source', 'URL Source'|trans({}, d)),
                    column_text('user_agent', 'User Agent'|trans({}, d)),
                    column_text('count',      'Hit Count'|trans({}, d),   'center'),
                    column_text('updated_at', 'Lastest Hit'|trans({}, d), 'center'),
                    column_html('_action',    'Actions'|trans({}, d),     'end'),
                ],
                rows: table_rows,
                emptyMessage: 'No error url.'|trans({}, d),
            }) }}

            {% if pageCount > 1 %}
                <nav class="mt-3"><ul class="pagination pagination-sm">
                    {% for p in 1..pageCount %}
                        <li class="page-item{% if p == page %} active{% endif %}">
                            <a class="page-link" href="?page={{ p }}{% if search %}&search={{ search }}{% endif %}">{{ p }}</a>
                        </li>
                    {% endfor %}
                </ul></nav>
            {% endif %}
        </div>
    </div>
</div>

{# Edit redirection modal #}
<div class="modal fade" id="edit_error_redirection_dialog" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(updateForm, {'attr': {'id': 'edit_error_redirection_form'}, 'action': ''}) }}
                <div class="modal-header">
                    <h5 class="modal-title">{{ 'Edit error redirection'|trans({}, d) }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        {{ form_label(updateForm.rewritten_url) }}
                        <input class="form-control" type="text" name="{{ updateForm.rewritten_url.vars.full_name }}" id="error_redirect_field" value="" placeholder="/path/mypage.html"/>
                        {% do updateForm.rewritten_url.setRendered %}
                    </div>
                    {{ form_rest(updateForm) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                    <button type="submit" class="btn btn-primary">{{ 'Save'|trans }}</button>
                </div>
            {{ form_end(updateForm) }}
        </div>
    </div>
</div>

{# Referer list modal #}
<div class="modal fade" id="referer_list_dialog" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Sources (Referer)'|trans({}, d) }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body"><ul id="referer_list"></ul></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Exit'|trans }}</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const updateBaseAction = "{{ path('admin_rewrite_url_manage_error_url_update', {'id': '__ID__'}) }}";
        const form = document.querySelector('#edit_error_redirection_form');
        const field = document.querySelector('#error_redirect_field');

        document.querySelectorAll('.redirection-button').forEach(function (button) {
            button.addEventListener('click', function () {
                if (form) { form.action = updateBaseAction.replace('__ID__', this.dataset.id); }
                if (field) { field.value = this.dataset.redirect || ''; }
            });
        });

        const refererList = document.querySelector('#referer_list');
        document.querySelectorAll('.referer-list-button').forEach(function (button) {
            button.addEventListener('click', async function () {
                refererList.innerHTML = '';
                const id = this.dataset.id;
                try {
                    const response = await fetch("{{ path('admin_rewrite_url_manage_error_url_get_referer', {'id': '__ID__'}) }}".replace('__ID__', id), { method: 'GET' });
                    if (!response.ok) { throw new Error('Network error'); }
                    const data = await response.json();
                    if (data.referer.length !== 0) {
                        data.referer.forEach(function (referer) {
                            const li = document.createElement('li');
                            li.appendChild(document.createTextNode(referer));
                            refererList.appendChild(li);
                        });
                    } else {
                        const li = document.createElement('li');
                        li.appendChild(document.createTextNode("{{ 'No data for this url.'|trans({}, d) }}"));
                        refererList.appendChild(li);
                    }
                } catch (e) {
                    console.error(e);
                }
            });
        });

        document.querySelectorAll('.js-delete-all').forEach(function (button) {
            button.addEventListener('click', function (e) {
                if (!confirm("{{ 'Delete all error urls?'|trans({}, d) }}")) { e.preventDefault(); }
            });
        });
    });
</script>
{% endblock %}
